#version 450
#extension GL_EXT_buffer_reference : require

// APS5_COPYBACK_DELTA (GuestBufferMemory.cpp): the copy back of a staged region writes into guest
// memory only the words of the shadow that differ from the reference, the shadow's bytes as the
// driver last made guest memory hold them, and brings the reference up to date.
layout(local_size_x = 256) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint words[]; };
layout(push_constant) uniform Parameters {
    Words source;
    Words reference;
    Words destination;
    uint count;
    uint unused;
} parameters;

void main() {
    const uint stride = gl_NumWorkGroups.x * 256u;
    for (uint index = gl_GlobalInvocationID.x; index < parameters.count; index += stride) {
        const uint value = parameters.source.words[index];
        if (parameters.reference.words[index] != value) {
            parameters.destination.words[index] = value;
            parameters.reference.words[index] = value;
        }
    }
}
